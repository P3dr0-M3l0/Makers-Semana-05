# Fonte de dados do frontend: "api" (Django, Semana 5) ou "firestore"
NEXT_PUBLIC_DATA_SOURCE=api

# "true" aponta o Firestore para o emulador local (127.0.0.1:8080)
NEXT_PUBLIC_USE_EMULATOR=false

# ID do projeto Firebase (usado fora do emulador)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=melo-makers

# URL base da API Django (vazio = mesma origem)
NEXT_PUBLIC_API_URL=
